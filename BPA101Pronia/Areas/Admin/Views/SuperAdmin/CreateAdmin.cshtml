@using BPA101Pronia.Areas.Admin.ViewModels.Account.Admin
@model CreateAdminVM

<div>
    <h2>
        Create Admin
    </h2>
    <form asp-controller="SuperAdmin" asp-action="CreateAdmin" method="post">
        <div class="form-group">
            <label for="Username">Username</label>
            <input asp-for="@Model.Username" type="text" class="form-control" id="Username" placeholder="Enter Username">
            <span asp-validation-for="@Model.Username" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label for="Email">Email</label>
            <input asp-for="@Model.Email" type="email" class="form-control" id="Email" placeholder="Enter Email">
            <span asp-validation-for="@Model.Email" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label for="Password">Password</label>
            <input asp-for="@Model.Password" type="password" class="form-control" id="Password" placeholder="Enter Password">
            <span asp-validation-for="@Model.Password" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label for="image">Confirm Password</label>
            <input asp-for="@Model.ConfirmPassword" type="password" class="form-control" id="ConfirmPassword" placeholder="Confirm Password">
            <span asp-validation-for="@Model.ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Add</button>
    </form>
</div>
