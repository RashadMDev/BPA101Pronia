@model List<AppUser>

<div>
    <h1>User Management</h1>
    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Name</th>
                <th scope="col">Surname</th>
                <th scope="col">Username</th>
                <th scope="col">Email</th>
                <th scope="col">Deleted Status</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (AppUser user in Model)
            {
                <tr>
                    <th scope="row">@user.Id</th>
                    <td>@user.Name</td>
                    <td>@user.Surname</td>
                    <td>@user.UserName</td>
                    <td>@user.Email</td>
                    @if (user.IsDeleted is false)
                    {
                        <td class="text-success">Active</td>
                    }
                    else
                    {
                        <td class="text-danger">Inactive</td>
                    }
                    <td>
                        @{
                            if (User.IsInRole("SuperAdmin"))
                            {
                                if (user.IsDeleted == false)
                                {


                                    <form asp-controller="SuperAdmin" asp-action="Delete" asp-route-id="@user.Id">
                                        <button type="submit" class="btn btn-danger">Delete</button>
                                    </form>
                            
                                }
                                else
                                {
                                    <form asp-controller="Slider" asp-action="Restore" asp-route-id="@user.Id">
                                        <button type="submit" class="btn btn-success">Restore</button>
                                    </form>
                                }
                            }
                            else
                            {
                                <p class="text-danger">Access Denied</p>
                            }
                        }
                        
                    </td>
                    <td><a asp-controller="Slider" asp-action="Update" asp-route-id="@user.Id" class="btn btn-warning">Update</a></td>
                    <td>
                        <form method="post" asp-controller="SuperAdmin" asp-action="AnnounceAdmin" asp-route-id="@user.Id">
                            <button type="submit" class="btn btn-primary">Admin</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>