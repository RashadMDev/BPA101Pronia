@using BPA101Pronia.Models
@model List<Slider>

<div>
    <h1>Slider Management</h1>
    <a asp-controller="Slider" asp-action="Add" class="btn btn-primary">Add</a>
    <table class="table table-striped">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Title</th>
                <th scope="col">Discount</th>
                <th scope="col">Description</th>
                <th scope="col">Deleted Status</th>
                <th scope="col">Image</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (Slider slider in Model)
            {
                <tr>
                    <th scope="row">@slider.Id</th>
                    <td>@slider.Title</td>
                    <td>@slider.Discount</td>
                    <td>@slider.Desc</td>
                    @if (slider.IsDeleted == false)
                    {
                        <td class="text-success">Active</td>
                    }
                    else
                    {
                        <td class="text-danger">Inactive</td>
                    }
                    <td><img style="width: 100px; height: 100px;" src="~/uploads/sliders/@slider.ImageUrl" alt="@slider.Title" /></td>
                    <td>

                        @if (slider.IsDeleted == false)
                        {
                            <form asp-controller="Slider" asp-action="Delete" asp-route-id="@slider.Id">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                            
                        }
                        else
                        {
                            <form asp-controller="Slider" asp-action="Restore" asp-route-id="@slider.Id">
                                <button type="submit" class="btn btn-success">Restore</button>
                            </form>
                        }

                        
                    </td>
                    <td><a asp-controller="Slider" asp-action="Update" asp-route-id="@slider.Id" class="btn btn-warning">Update</a></td>
                </tr>
            }
        </tbody>
    </table>

</div>