@model Slider

<div>
    <h2>
        Add Slider
    </h2>
    <form asp-controller="Slider" asp-action="Add" method="post" enctype="multipart/form-data">
        <div class="form-group">
            <label for="title">Title</label>
            <input asp-for="@Model.Title" type="text" class="form-control" id="title" placeholder="Enter title">
            <span asp-validation-for="@Model.Title" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label for="discount">Discount</label>
            <input asp-for="@Model.Discount" type="number" class="form-control" id="discount" placeholder="Enter discount">
            <span asp-validation-for="@Model.Discount" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label for="description">Description</label>
            <input asp-for="@Model.Desc" type="text" class="form-control" id="description" placeholder="Enter description">
            <span asp-validation-for="@Model.Desc" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label for="image">Image</label>
            <input asp-for="@Model.ImageFile" type="file" class="form-control" id="image" placeholder="Enter image url">
            <span asp-validation-for="@Model.ImageFile" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Add</button>
    </form>
</div>
