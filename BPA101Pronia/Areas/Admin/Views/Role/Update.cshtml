@using BPA101Pronia.Areas.Admin.ViewModels.Role
@model UpdateRoleVM

<div>
      <h2>
            Create Role
      </h2>
      <form asp-controller="Role" asp-action="Update" asp-route-id="@Model.Id" method="post">
            <div class="form-group">
                  <label for="Name">Title</label>
                  <input asp-for="@Model.Name" type="text" class="form-control" id="Name" placeholder="Enter Role name">
                  <span asp-validation-for="@Model.Name" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Add</button>
      </form>
</div>
