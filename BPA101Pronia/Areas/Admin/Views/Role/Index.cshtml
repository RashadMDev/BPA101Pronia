@using Microsoft.AspNetCore.Identity
@model List<IdentityRole>

<div>
      <h1><i class="mdi mdi-rotate-left:"></i> Management</h1>
      <a asp-controller="Role" asp-action="Create" class="btn btn-primary">Create Role</a>
      <table class="table table-striped">
            <thead>
                  <tr>
                        <th scope="col">#</th>
                        <th scope="col">Role Name</th>
                        <th scope="col">Actions</th>
                  </tr>
            </thead>
            <tbody>
                  @foreach (IdentityRole role in Model)
                  {
                        <tr>
                              <th scope="row">@role.Id</th>
                              <td>@role.Name</td>
                              <td>
                                    <form asp-controller="Role" asp-action="Delete" asp-route-id="@role.Id">
                                          <button type="submit" class="btn btn-danger">Delete</button>
                                    </form>

                              </td>
                              <td>
                                    <a asp-controller="Role" asp-action="Update" asp-route-id="@role.Id"
                                       class="btn btn-warning">Update</a>
                              </td>
                        </tr>
                  }
            </tbody>
      </table>

</div>